{
  "name": "@fixyourdocs/mcp-server",
  "version": "0.1.0",
  "mcpName": "io.fixyourdocs/mcp-server",
  "description": "Model Context Protocol server for the Docs Feedback Protocol — exposes a single `file_doc_feedback` tool that any MCP client (Claude Desktop, Cursor, Codex, Gemini CLI) can call to file a structured docs-feedback report to https://hub.fixyourdocs.io",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fixyourdocs",
    "docs-feedback",
    "ai",
    "claude",
    "cursor",
    "codex"
  ],
  "license": "Apache-2.0",
  "homepage": "https://fixyourdocs.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/fixyourdocs/fixyourdocs.git",
    "directory": "mcp-server"
  },
  "bugs": {
    "url": "https://github.com/fixyourdocs/fixyourdocs/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "./dist/cli.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "dev": "pnpm build && node dist/cli.js",
    "inspector": "pnpm build && npx -y @modelcontextprotocol/inspector node dist/cli.js"
  },
  "dependencies": {
    "@fixyourdocs/sdk": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
