# Frontend runtime config overrides for local dev.
# Vite reads VITE_* vars from a local .env (gitignored — copy this file to .env).
# In production these values come from frontend/public/env.js (window.__ENV__),
# generated at deploy time from stack outputs. See src/lib/env.ts for the
# variables actually read and their fallbacks.

VITE_HUB_BASE_URL=https://hub.fixyourdocs.io
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_YOUR_POOL_ID
VITE_COGNITO_CLIENT_ID=YOUR_CLIENT_ID
VITE_APP_BASE_URL=http://localhost:5173
